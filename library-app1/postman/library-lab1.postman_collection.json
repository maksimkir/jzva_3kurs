              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Domain-Driven Design (2nd printing)\",\n  \"author\": \"Eric Evans\",\n  \"isbn\": \"9780321125217\",\n  \"publishedYear\": 2004,\n  \"description\": \"Tackling complexity in the heart of software\"\n}"
            }
          }
        }
      ]
    },
