              "raw": "{\n  \"title\": \"Domain-Driven Design\",\n  \"author\": \"Eric Evans\",\n  \"isbn\": \"9780321125217\",\n  \"publishedYear\": 2003,\n  \"description\": \"Tackling complexity in the heart of software\"\n}"
            }
