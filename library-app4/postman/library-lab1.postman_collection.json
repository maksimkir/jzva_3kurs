  "item": [
    {
      "name": "0. Auth (JWT від Keycloak)",
      "item": [
        {
          "name": "Get ADMIN token (admin/admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"adminToken\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "library-app"
                },
                {
                  "key": "client_secret",
                  "value": "library-secret"
                },
                {
                  "key": "username",
                  "value": "admin"
                },
                {
                  "key": "password",
                  "value": "admin"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/library/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "library",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
          }
        },
        {
          "name": "Get USER token (user/user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"userToken\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "library-app"
                },
                {
                  "key": "client_secret",
                  "value": "library-secret"
                },
                {
                  "key": "username",
                  "value": "user"
                },
                {
                  "key": "password",
                  "value": "user"
